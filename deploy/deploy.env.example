# settings for deploy/deploy.sh, sourced as bash. copy this to
# ${XDG_CONFIG_HOME:-$HOME/.config}/transmog/deploy.env, or point
# DEPLOY_ENV at another file, and fill in the paths for the machine.
# every value below is a placeholder.

# where transmog-<sha>, current, previous, staged and failed live
BIN_DIR=/home/USER/transmog/bin

# the systemd-run user unit to move onto a new build. deploy reads its
# arguments and properties from the unit's transient file before it stops
# it, and starts it again with systemd-run under the same name
UNIT=transmog-example

# a deploy waits while this file exists, up to PAUSE_TIMEOUT seconds; a qa
# run creates it to hold the unit still
#PAUSE_FILE=$XDG_RUNTIME_DIR/transmog/deploy.pause
#PAUSE_TIMEOUT=1800

# run with each one-line summary as $1, e.g. to post it somewhere
#LOG_HOOK='printf "%s\n" "$1" >>/home/USER/transmog/deploy-summaries.txt'

# health hooks, each run with bash -c after the built-in gates; any
# non-zero exit fails the deploy. they see DEPLOY_PID, DEPLOY_UNIT,
# DEPLOY_BIN and TAP_DIR. a receiver check and a window placement:
#HEALTH_CMDS=(
#	'/home/USER/bin/td-received-frames --min 25'
#	'/home/USER/bin/place-window transmog OUTPUT-1'
#)

# units restarted once the new process's tap is up, since they read it
#RESTART_UNITS=(tap-reader-example)

# properties added to the unit's own on every start, as systemd-run -p
# takes them. Restart brings the process back after a usb drop; the
# process gate still fails a deploy whose pid changes during the checks
#UNIT_PROPS=(Restart=on-failure RestartSec=2)

# replaces the arguments read from the unit, for when the unit is gone and
# no deploy saved them; the binary is always the build being deployed
#UNIT_ARGS=(gui --tap --preset qa --ndi)

# gates; the defaults are shown
#HEALTH_SECS=20      # how long the new process is watched
#STARTUP_SECS=15     # how long the tap may take to appear
#MIN_FPS=29          # tap frames a second over HEALTH_SECS
#MAX_SEQ_GAPS=10     # v4l2 frames the driver dropped over HEALTH_SECS
#NDI_PORTS="5960 5961"   # must be listened on by the new process; empty skips
#PORT_WAIT_SECS=10   # wait for these to be free after the stop
#HEALTH_CMD_TIMEOUT=30

# the tap dir defaults to the unit's --tap DIR or
# $XDG_RUNTIME_DIR/transmog/tap
#TAP_DIR=

# the deploy log, gc roots, saved unit arguments and lock
#DEPLOY_LOG=$HOME/.local/state/transmog/deploy.log
#STATE_DIR=$HOME/.local/state/transmog/deploy

# extra flags for the nix build and for --local-ci's nix flake check, split
# on spaces; --max-jobs 0 sends every build to the machine's remote builders
NIX_FLAGS='--max-jobs 0'

# the branch a commit has to be on, and whose ci runs count
#CI_BRANCH=integration
